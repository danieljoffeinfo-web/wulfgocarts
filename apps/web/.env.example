# Hero film source.
#
# Preferred (production): self-host the film. Download the render, run it
# through scripts/encode-scrub.sh, drop the output at
# apps/web/public/hero/scrub.mp4, then set:
#
#   NEXT_PUBLIC_HERO_FILM=/hero/scrub.mp4
#   NEXT_PUBLIC_HERO_POSTER=/hero/scrub-poster.jpg
#
# The encode step forces every frame to be a keyframe. Without it, seeking
# snaps to the nearest keyframe and the scrub visibly judders.
#
# If unset, the app falls back to the Higgsfield CDN URL baked into
# app/page.tsx — fine for a preview, not for production.

NEXT_PUBLIC_HERO_FILM=
NEXT_PUBLIC_HERO_POSTER=
